APP_NAME=OfflineAICompanion
APP_ENV=development
LOG_LEVEL=INFO

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

WEATHER_API_KEY=
NEWS_API_KEY=

DATABASE_PATH=sample-data/memory/companion.db

MIC_ENABLED=true

WHISPER_EXECUTABLE=deployment/windows/whisper-cpp/Release/whisper-cli.exe
WHISPER_MODEL_PATH=deployment/models/ggml-tiny.en.bin
WHISPER_LANGUAGE=en

PIPER_EXECUTABLE=deployment/windows/piper/piper.exe
PIPER_MODEL_PATH=deployment/models/piper/en_US-lessac-medium.onnx

VAD_THRESHOLD=0.018