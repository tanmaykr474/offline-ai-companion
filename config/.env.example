APP_NAME=OfflineAICompanion
APP_ENV=development
LOG_LEVEL=INFO

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

WEATHER_API_KEY=
NEWS_API_KEY=

# External calls are opt-in. Neither setting changes local-only Ollama.
NOVA_ONLINE_TOOLS_ENABLED=false
NOVA_WEATHER_PROVIDER=open-meteo
NOVA_NEWS_PROVIDER=newsapi
# Explicit city and optional country/admin qualifier; blank means ask each time.
NOVA_WEATHER_LOCATION=
# Per-request timeout, max 15 seconds; no automatic retries.
NOVA_ONLINE_TIMEOUT=5
NOVA_NEWS_LIMIT=3
NOVA_NEWS_COUNTRY=us
NOVA_NEWS_TOPICS=general,technology,ai,cybersecurity,science,business,sports,health
NOVA_NEWS_MAX_AGE_HOURS=48

DATABASE_PATH=sample-data/memory/companion.db

MIC_ENABLED=true

WHISPER_EXECUTABLE=deployment/windows/whisper-cpp/Release/whisper-cli.exe
WHISPER_MODEL_PATH=deployment/models/ggml-tiny.en.bin
WHISPER_LANGUAGE=en

PIPER_EXECUTABLE=deployment/windows/piper/piper.exe
PIPER_MODEL_PATH=deployment/models/piper/en_US-lessac-medium.onnx

VAD_THRESHOLD=0.018

# Explicit IANA timezone for reminder calendar commands (independent of OS timezone).
REMINDER_TIMEZONE=Asia/Kolkata

# Optional PortAudio indices; empty uses the current Windows defaults.
NOVA_INPUT_DEVICE=
NOVA_OUTPUT_DEVICE=
# Opt-in numeric/stage diagnostics, never raw speech or subprocess stderr.
NOVA_AUDIO_DIAGNOSTICS=false
# Experimental cancellation; existing half-duplex behavior remains the default.
NOVA_EXPERIMENTAL_INTERRUPTION=false
# Exact wake phrase + stop only; no acoustic echo cancellation. Use headphones.
NOVA_SPOKEN_INTERRUPTION=false
NOVA_INTERRUPT_LLM_TIMEOUT=30
NOVA_INTERRUPT_STT_TIMEOUT=5
# Numeric resource/counter snapshots only; no transcript/audio collection.
NOVA_RUNTIME_DIAGNOSTICS=false
NOVA_RUNTIME_INTERVAL=30
