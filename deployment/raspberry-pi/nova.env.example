# Pi only. Copy to nova.env with mode 600. Do not reuse the Windows .env.
NOVA_PROFILE=raspberry-pi
APP_ENV=production
LOG_LEVEL=INFO
WHISPER_EXECUTABLE=deployment/raspberry-pi/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=deployment/models/ggml-tiny.en.bin
WHISPER_LANGUAGE=en
WHISPER_THREADS=2
PIPER_EXECUTABLE=deployment/raspberry-pi/piper.sh
PIPER_MODEL_PATH=deployment/models/piper/en_US-lessac-medium.onnx
DATABASE_PATH=data/private/companion.db
NOVA_AUDIO_DIRECTORY=data/audio
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
NOVA_OLLAMA_NUM_CTX=1024
NOVA_OLLAMA_NUM_THREAD=2
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=1
NOVA_AUDIO_QUEUE_SIZE=50
NOVA_INPUT_DEVICE=
NOVA_OUTPUT_DEVICE=
# Start muted. M + Enter enables capture in the foreground Linux terminal.
MIC_ENABLED=false
# Enable only after measuring capacity; accepted work still drains on shutdown.
PASSIVE_MEMORY_ENABLED=false
PASSIVE_MEMORY_QUEUE_SIZE=2
PASSIVE_MEMORY_LLM_TIMEOUT=30
PASSIVE_MEMORY_RETENTION_DAYS=0
NOVA_EXPERIMENTAL_INTERRUPTION=false
NOVA_SPOKEN_INTERRUPTION=false
NOVA_ONLINE_TOOLS_ENABLED=false
NOVA_RUNTIME_DIAGNOSTICS=false
NOVA_PERFORMANCE_LOG=false
NOVA_AUDIO_DIAGNOSTICS=false
# Explicit starting timezone; change to your local IANA timezone before reminders.
REMINDER_TIMEZONE=Asia/Kolkata
